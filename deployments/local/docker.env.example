# =============================================================================
# deployments/local/docker.env.example — template env untuk Docker Compose.
#
# Cara pakai:
#     cp deployments/local/docker.env.example deployments/local/docker.env
#
# docker-compose.yml memuat file ini lewat `env_file: ./docker.env` untuk setiap
# container aplikasi, dan memount-nya ke /app/docker.env di dalam container.
#
# deployments/local/docker.env TIDAK di-commit (lihat .gitignore) karena berisi
# kredensial. Jangan pernah commit hasil copy-nya.
# =============================================================================

APP_ENV=docker

# --- MongoDB: satu instance; DB per-context sebagai database terpisah ---
# Setiap microservice membaca <MODULE>_DB_HOST/_PORT/_NAME
# (Spring: spring.data.mongodb.uri). db-migration (Mongock) menarget DB-nya sendiri.
DB_MIGRATE_HOST=mongo
DB_MIGRATE_PORT=27017
DB_MIGRATE_NAME=pg_identity

# identity context → pg_identity
AUTH_DB_HOST=mongo
AUTH_DB_PORT=27017
AUTH_DB_NAME=pg_identity
ROLE_DB_HOST=mongo
ROLE_DB_PORT=27017
ROLE_DB_NAME=pg_identity
USER_DB_HOST=mongo
USER_DB_PORT=27017
USER_DB_NAME=pg_identity
# payment context → pg_payment
CARD_DB_HOST=mongo
CARD_DB_PORT=27017
CARD_DB_NAME=pg_payment
MERCHANT_DB_HOST=mongo
MERCHANT_DB_PORT=27017
MERCHANT_DB_NAME=pg_payment
SALDO_DB_HOST=mongo
SALDO_DB_PORT=27017
SALDO_DB_NAME=pg_payment
# financial context → pg_financial
TOPUP_DB_HOST=mongo
TOPUP_DB_PORT=27017
TOPUP_DB_NAME=pg_financial
TRANSFER_DB_HOST=mongo
TRANSFER_DB_PORT=27017
TRANSFER_DB_NAME=pg_financial
TRANSACTION_DB_HOST=mongo
TRANSACTION_DB_PORT=27017
TRANSACTION_DB_NAME=pg_financial
WITHDRAW_DB_HOST=mongo
WITHDRAW_DB_PORT=27017
WITHDRAW_DB_NAME=pg_financial

SECRET_KEY=change-me

# --- Redis ---
REDIS_HOST=redis-node-1
REDIS_PORT=6379
REDIS_PASSWORD=dragon_knight
REDIS_ADDRS=redis-node-1:6379,redis-node-2:6379,redis-node-3:6379,redis-node-4:6379,redis-node-5:6379,redis-node-6:6379
REDIS_DB=0

# --- ClickHouse (OLAP) ---
CLICKHOUSE_ADDR=clickhouse:9000
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USERNAME=dragon
CLICKHOUSE_PASSWORD=dragon_knight
CLICKHOUSE_URL=jdbc:clickhouse://clickhouse:8123/default

# --- Kafka (KRaft) ---
KAFKA_BROKERS=kafka-1:9092

APP_LOGGER=production

# Hari generate statement kartu (1-31)
BILLING_CYCLE_DAY=1

# Limit withdraw harian per kartu
WITHDRAW_DAILY_LIMIT=10000000

# --- Observability ---
OTEL_ENDPOINT=otel-collector:4317

# --- gRPC client resolution (gateway + inter-service) ---
# Gateway/domain services membaca <NAME>_HOST/_PORT (grpc.client.<name>.host/port).
GATEWAY_PORT=8080
EMAIL_HTTP_PORT=8092
ROLE_HOST=role
ROLE_PORT=9006
USER_HOST=user
USER_PORT=9011
AUTH_HOST=auth
AUTH_PORT=9012
MERCHANT_HOST=merchant
MERCHANT_PORT=9005
CARD_HOST=card
CARD_PORT=9004
SALDO_HOST=saldo
SALDO_PORT=9007
TOPUP_HOST=topup
TOPUP_PORT=9008
TRANSACTION_HOST=transaction
TRANSACTION_PORT=9009
TRANSFER_HOST=transfer
TRANSFER_PORT=9010
WITHDRAW_HOST=withdraw
WITHDRAW_PORT=9013

# --- SMTP (email worker). Isi dengan kredensial milikmu sendiri. ---
SMTP_SERVER=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
